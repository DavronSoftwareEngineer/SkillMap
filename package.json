{
  "name": "skillmap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "vitest run",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corporate-sdk": "node scripts/test-corporate-sdk.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:production": "node scripts/test-production.mjs",
    "dev:api": "tsx server/dev.ts",
    "db:migrate:local": "tsx scripts/migrate-local.ts",
    "test:backend": "tsx --test server/api.test.ts",
    "test:fullstack": "node scripts/test-fullstack.mjs"
  },
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "vite": "8.1.5",
    "vitest": "4.1.11"
  }
}
