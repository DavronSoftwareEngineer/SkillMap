# Backend only. Never prefix these secrets with VITE_.
# Local PostgreSQL. Production uses Netlify Database and its automatic NETLIFY_DB_URL.
# Set a stable SYNC_ENCRYPTION_KEY in Netlify's Functions environment variables.
# SKILLMAP_DATABASE_URL is only needed locally or for a separate external PostgreSQL database.
# Do not use a localhost URL in production. Remote connections use verified TLS.
SKILLMAP_DATABASE_URL=postgres://skillmap:skillmap_local@127.0.0.1:54329/skillmap_local
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set a stable 64-character hex key in Netlify environment variables too.
SYNC_ENCRYPTION_KEY=
