# Backend only. Never prefix these secrets with VITE_.
# Local PostgreSQL; production uses Netlify Database's NETLIFY_DB_URL.
SKILLMAP_DATABASE_URL=postgres://skillmap:skillmap_local@127.0.0.1:54329/skillmap_local
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set a stable 64-character hex key in Netlify environment variables too.
SYNC_ENCRYPTION_KEY=
